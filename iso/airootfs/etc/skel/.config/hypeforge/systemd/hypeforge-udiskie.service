# hypeForge background helper (D-25: helpers run as user services under uwsm).
[Unit]
Description=hypeForge: USB drives (udiskie)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/udiskie --tray --notify
Restart=on-failure
RestartSec=2
Slice=background-graphical.slice

[Install]
WantedBy=graphical-session.target
