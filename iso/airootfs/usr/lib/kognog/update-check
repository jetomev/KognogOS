#!/usr/bin/env python3
"""
Refresh the KognogOS pending-update snapshot.

Run by kognog-updates.timer in the user scope. Writes a small JSON file
that the shell greeting reads instantly, so opening a terminal never
waits on the network: `checkupdates` syncs a package database, and that
cost belongs in the background rather than in front of a prompt.

Snapshot: ${XDG_CACHE_HOME:-~/.cache}/kognog/updates.json

    {"generated": 1755109871, "count": 142, "level": "yellow",
     "ready": [{"pkg": "linux-zen", "tier": 1, "over": 3}],
     "next": {"pkg": "plasma-desktop", "tier": 2, "remaining": 6}}

Levels
    green    nothing pending
    yellow   updates pending, but no Tier 1 or Tier 2 package is ready
    red      a Tier 1 or Tier 2 package is READY -- its hold window has
             elapsed, so nog will install it on the next run

What "ready" means, and what it does not
---------------------------------------
A tier hold is counted from the moment the UPDATE was published, not from
the age of what is currently installed. Those are very different numbers
and only the first one matches nog. Measured on this machine: the running
kernel was 97 days old, which looks alarming, while the update replacing
it had been available for 3 days and nog correctly reported "27 days
remaining". Reporting the installed build's age called that overdue when
nothing was actionable at all.

So: only packages whose window has actually elapsed are counted, and only
in Tier 1 and Tier 2 -- Tier 3 rides its 7-day window without needing to
be announced.

Elapsed days are rounded UP, because that is what nog does. Truncating
was uniformly one day short across all fourteen Tier 1/2 packages in the
2026-08-13 run; rounding up reproduces nog's numbers exactly.

Build dates come from the same synced database `checkupdates` populated,
never the system one -- the system copy can be days stale, which would
date an update that is not even in it.

Scope: official repositories only, because that is what `checkupdates`
covers. AUR, Flatpak and Snap are tracked by nog but not here; the
durable fix is for nog itself to publish this snapshot (roadmap C4,
`nog status --json`) and for this script to retire into a thin caller.

On failure -- no network, no pacman-contrib -- the previous snapshot is
left untouched and the exit status is non-zero. A stale but true answer
beats an empty one, and the greeting reports how old it is.

SPDX-FileCopyrightText: 2026 Javier
SPDX-License-Identifier: GPL-3.0-or-later
"""

import datetime
import json
import math
import os
import pathlib
import subprocess
import sys
import time

NOG_CONF = "/etc/nog/nog.conf"
TIER_PINS = "/etc/nog/tier-pins.toml"

DEFAULT_HOLDS = {1: 30, 2: 15, 3: 7}
WATCHED_TIERS = (1, 2)

PACMAN_ENV = {"LC_ALL": "C", "PATH": "/usr/bin:/bin"}


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    d = pathlib.Path(base) / "kognog"
    d.mkdir(parents=True, exist_ok=True)
    return d


def load_tiers():
    """{package: tier}. Tier 3 is 'everything else' and has no list."""
    try:
        import tomllib
        with open(TIER_PINS, "rb") as fh:
            pins = tomllib.load(fh)
    except (OSError, ImportError, ValueError):
        return {}
    tiers = {}
    for t in (1, 2, 3):
        for pkg in pins.get(f"tier{t}", {}).get("packages", []) or []:
            tiers[pkg] = t
    return tiers


def load_holds():
    try:
        import tomllib
        with open(NOG_CONF, "rb") as fh:
            holds = tomllib.load(fh).get("holds", {})
    except (OSError, ImportError, ValueError):
        return dict(DEFAULT_HOLDS)
    return {t: int(holds.get(f"tier{t}_days", DEFAULT_HOLDS[t])) for t in (1, 2, 3)}


def pending_updates(db):
    """Package names with an official-repo update waiting.

    checkupdates exits 2 when there is simply nothing to do, which is a
    successful answer of "zero", not a failure.
    """
    env = dict(os.environ, CHECKUPDATES_DB=str(db))
    proc = subprocess.run(["checkupdates"], capture_output=True, text=True, env=env)
    if proc.returncode == 2:
        return []
    if proc.returncode != 0:
        raise RuntimeError(
            (proc.stderr or proc.stdout or "checkupdates failed").strip())
    return [line.split()[0] for line in proc.stdout.splitlines() if line.strip()]


def days_available(packages, db):
    """{package: days since the PENDING version was built}, rounded up."""
    if not packages:
        return {}
    proc = subprocess.run(["pacman", "-Si", "--dbpath", str(db), *packages],
                          capture_output=True, text=True, env=PACMAN_ENV)
    out, name, now = {}, None, datetime.datetime.now()
    for line in proc.stdout.splitlines():
        if line.startswith("Name "):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Build Date") and name:
            stamp = line.split(":", 1)[1].strip()
            try:
                built = datetime.datetime.strptime(stamp, "%a %b %d %H:%M:%S %Y")
            except ValueError:
                continue
            # Ceiling, not truncation -- matches nog exactly.
            out[name] = math.ceil((now - built).total_seconds() / 86400)
    return out


def main():
    cache = cache_dir()
    out = cache / "updates.json"

    # checkupdates syncs into its own database; pinning it here keeps the
    # snapshot out of /tmp and reusable between runs.
    db = cache / "db"
    db.mkdir(parents=True, exist_ok=True)

    try:
        pending = pending_updates(db)
    except (RuntimeError, FileNotFoundError) as exc:
        print(f"update-check: {exc}", file=sys.stderr)
        print(f"update-check: keeping previous snapshot at {out}", file=sys.stderr)
        return 1

    tiers, holds = load_tiers(), load_holds()

    watched = [p for p in pending if tiers.get(p) in WATCHED_TIERS]
    available = days_available(watched, db)

    ready, waiting = [], []
    for pkg in watched:
        tier = tiers[pkg]
        days = available.get(pkg)
        if days is None:
            continue
        remaining = holds[tier] - days
        if remaining <= 0:
            ready.append({"pkg": pkg, "tier": tier, "over": -remaining})
        else:
            waiting.append({"pkg": pkg, "tier": tier, "remaining": remaining})

    ready.sort(key=lambda r: (-r["over"], r["tier"], r["pkg"]))
    waiting.sort(key=lambda w: (w["remaining"], w["tier"], w["pkg"]))

    if not pending:
        level = "green"
    elif ready:
        level = "red"
    else:
        level = "yellow"

    snapshot = {
        "generated": int(time.time()),
        "count": len(pending),
        "level": level,
        "ready": ready,
        # The nearest Tier 1/2 package still inside its window, so a yellow
        # greeting can say when it stops being yellow.
        "next": waiting[0] if waiting else None,
    }

    tmp = out.with_suffix(".tmp")
    tmp.write_text(json.dumps(snapshot, indent=2) + "\n")
    os.replace(tmp, out)

    note = f"{len(ready)} ready in tier 1/2" if ready else "none ready in tier 1/2"
    print(f"update-check: {len(pending)} pending, {note}, {level} -> {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
