[Unit]
Description=Weekly repo + AUR watch — is anyone waiting on a reply?
Documentation=file:///home/jetomev/Programs/kognog/scripts/repo-aur-watch.py
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/jetomev/Programs/kognog/scripts/repo-aur-watch.py
